# MiniMax Token Plan key (sk-cp-...)
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
# 国内 Token Plan；国际站用户改为 https://api.minimax.io/anthropic/v1
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic/v1

# minimax | codex
AGENT_PROVIDER=minimax

# 模型可靠性策略：单次超时、失败重试次数、首次退避时间
AGENT_MODEL_TIMEOUT_MS=120000
AGENT_MODEL_MAX_RETRIES=1
AGENT_RETRY_DELAY_MS=500
AGENT_MAX_RETRY_DELAY_MS=8000

# 可选：平滑限制模型请求速率，例如每分钟 60 次会变成约每秒 1 次
# AGENT_RATE_LIMIT_MAX_REQUESTS=60
# AGENT_RATE_LIMIT_WINDOW_MS=60000

# 可选：每次 Agent run 的 token/cost 软预算；达到后不再启动下一次模型调用
# AGENT_MAX_INPUT_TOKENS=100000
# AGENT_MAX_OUTPUT_TOKENS=20000
# AGENT_MAX_TOTAL_TOKENS=120000
# AGENT_MAX_COST=10
# 成本价格和币种不硬编码；国内可填 CNY，国际站可填 USD
# AGENT_COST_CURRENCY=CNY
# AGENT_INPUT_COST_PER_MILLION_TOKENS=
# AGENT_OUTPUT_COST_PER_MILLION_TOKENS=
# AGENT_CACHE_READ_COST_PER_MILLION_TOKENS=
# AGENT_CACHE_WRITE_COST_PER_MILLION_TOKENS=

# 逗号分隔；留空表示不给模型开放任何工具
AGENT_TOOLS=calculator,current_time
# 默认 sequential；确认同一轮工具彼此独立后才改为 parallel
AGENT_TOOL_EXECUTION=sequential

# 可选安全文件工具：所有路径都限制在 root 内；写工具默认不注册
# AGENT_WORKSPACE_ROOT=.
# AGENT_WORKSPACE_ALLOW_WRITE=false

# 可选：一行一个 OpenTelemetry-compatible span；默认不记录 prompt/tool 参数
# AGENT_TRACE_FILE=.agent-data/traces.jsonl

# 可选持久化 memory；不设置时对话只保存在当前进程
# AGENT_MEMORY_FILE=.agent-data/conversations.json
# SQLite 与 JSON 二选一；更适合多个会话和进程重启恢复
# AGENT_MEMORY_DATABASE=.agent-data/conversations.sqlite3
# AGENT_SESSION_ID=cli

# 可选 ContextBuilder：只裁剪本轮模型输入，不删除持久化的完整历史
# AGENT_CONTEXT_MAX_MESSAGES=40
# AGENT_CONTEXT_MAX_CHARACTERS=50000

# 可选长期记忆索引：与 conversation 数据库职责不同
# AGENT_MEMORY_INDEX_DATABASE=.agent-data/memory-index.sqlite3
# AGENT_MEMORY_RECALL_LIMIT=5

# Skill 只读取并注入指令，不会自动执行代码或开放工具
AGENT_SKILLS_DIR=skills
# AGENT_SKILLS=tool-first
# 使用 auto 时，根据最新用户输入从 name/description 动态选择
# AGENT_SKILLS=auto

# pi-agent 示例默认复用上面的 AGENT_*；需要隔离时可使用这些覆盖项
# PI_AGENT_TOOLS=calculator,current_time
# PI_AGENT_MEMORY_FILE=.agent-data/pi-conversations.json
# PI_AGENT_MEMORY_DATABASE=.agent-data/pi-conversations.sqlite3
# PI_AGENT_MEMORY_INDEX_DATABASE=.agent-data/pi-memory-index.sqlite3
# PI_AGENT_SESSION_ID=pi-cli
# PI_AGENT_SKILLS_DIR=skills
# PI_AGENT_SKILLS=tool-first
