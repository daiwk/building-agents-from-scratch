# MiniMax Token Plan key (sk-cp-...)
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
# 国内 Token Plan；国际站用户改为 https://api.minimax.io/anthropic/v1
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic/v1

# minimax | codex
AGENT_PROVIDER=minimax

# 模型可靠性策略：单次超时、失败重试次数、首次退避时间
AGENT_MODEL_TIMEOUT_MS=120000
AGENT_MODEL_MAX_RETRIES=1
AGENT_RETRY_DELAY_MS=500
