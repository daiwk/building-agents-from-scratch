{
  "name": "building-agents-from-scratch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A tiny, readable agent architecture inspired by pi-agent.",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "web": "tsx src/web/server.ts",
    "example": "tsx examples/quick-start.ts",
    "pi-example": "tsx examples/pi-agent-direct.ts",
    "pi-check": "tsx examples/pi-agent-direct.ts --dry-run",
    "eval": "tsx src/evals/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.83.0",
    "@earendil-works/pi-ai": "^0.83.0"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.19"
  }
}
